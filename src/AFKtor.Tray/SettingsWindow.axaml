<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AFKtor.Tray.SettingsWindow"
        Title="AFKtor settings"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Label Content="Accept _delay (seconds):"
                   Target="{Binding ElementName=Delay}"
                   VerticalAlignment="Center" />
            <NumericUpDown x:Name="Delay"
                           Width="130"
                           Increment="1"
                           FormatString="0"
                           ParsingNumberStyle="Integer"
                           ClipValueToMinMax="True"
                           AutomationProperties.Name="Accept delay in seconds" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap"
                   Text="Changes apply to the next ready check.&#10;0 seconds verifies and accepts immediately." />
        <StackPanel Spacing="4">
            <CheckBox x:Name="ArmOnLaunch"
                      Content="_Arm auto-accept when AFKtor starts" />
            <TextBlock TextWrapping="Wrap"
                       Margin="28,0,0,0"
                       Opacity="0.7"
                       Text="Off by default. A ready check already showing when League connects is still left for you." />
        </StackPanel>
        <StackPanel Spacing="4">
            <CheckBox x:Name="StartWithWindows"
                      Content="Start AFKtor when I sign in to _Windows" />
            <TextBlock x:Name="StartWithWindowsUnavailable"
                       IsVisible="False"
                       TextWrapping="Wrap"
                       Margin="28,0,0,0"
                       Opacity="0.7"
                       Text="Available when AFKtor runs from its own AFKtor.Tray.exe on Windows." />
        </StackPanel>
        <TextBlock x:Name="Error"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="Save" Content="_Save" IsDefault="True" />
            <Button x:Name="Cancel" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
